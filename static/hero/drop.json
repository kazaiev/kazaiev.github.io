reader\u00b7core,\u00b7which\u00b7reopens\u00b7the\u00b7last\u00b7book\u00b7at\u00b7its\u00b7saved\u00b7page.\u00b7Each\u00b7button\u00b7//!\u00b7press\u00b7goes\u00b7to\u00b7the\u00b7core,\u00b7and\u00b7the\u00b7panel\u00b7gets\u00b7a\u00b7partial\u00b7refresh\u00b7whenever\u00b7the\u00b7//!\u00b7screen\u00b7changes,\u00b7and\u00b7a\u00b7full\u00b7one\u00b7every\u00b7few\u00b7changes\u00b7(the\u00b7\"Full\u00b7refresh\"\u00b7//!\u00b7setting).\u00b7After\u00b7the\u00b7idle\u00b7time\u00b7set\u00b7in\u00b7Settings,\u00b7the\u00b7board\u00b7leaves\u00b7any\u00b7//!\u00b7menu,\u00b7puts\u00b7up\u00b7the\u00b7sleep\u00b7screen\u00b7(the\u00b7book's\u00b7cover,\u00b7a\u00b7picture\u00b7from\u00b7the\u00b7//!\u00b7card,\u00b7or\u00b7\"Battery\u00b7low\";\u00b7or\u00b7it\u00b7leaves\u00b7the\u00b7page),\u00b7cuts\u00b7SD\u00b7power\u00b7and\u00b7deep\u00b7//!\u00b7sleeps.\u00b7Any\u00b7button\u00b7wakes\u00b7it;\u00b7it\u00b7boots\u00b7again\u00b7into\u00b7the\u00b7same\u00b7page,\u00b7and\u00b7if\u00b7//!\u00b7the\u00b7page\u00b7was\u00b7left\u00b7up,\u00b7the\u00b7press\u00b7that\u00b7woke\u00b7it\u00b7acts\u00b7on\u00b7it.\u00b7On\u00b7an\u00b7empty\u00b7//!\u00b7battery\u00b7it\u00b7shows\u00b7\"Battery\u00b7empty\"\u00b7and\u00b7sleeps\u00b7again\u00b7without\u00b7opening\u00b7the\u00b7//!\u00b7book.\u00b7//!\u00b7//!\u00b7The\u00b7page\u00b7buttons\u00b7on\u00b7the\u00b7side\u00b7give\u00b7Prev,\u00b7Next\u00b7and\u00b7Menu,\u00b7and\u00b7holding\u00b7Menu\u00b7//!\u00b7gives\u00b7Back.\u00b7The\u00b7board's\u00b7own\u00b7wake\u00b7button\u00b7is\u00b7not\u00b7used\u00b7(see\u00b7`buttons`).\u00b7#![no_std]\u00b7#![no_main]\u00b7extern\u00b7crate\u00b7alloc;\u00b7mod\u00b7battery;\u00b7mod\u00b7buttons;\u00b7mod\u00b7expander;\u00b7mod\u00b7panel;\u00b7mod\u00b7sd;\u00b7mod\u00b7storage;\u00b7use\u00b7alloc::format;\u00b7use\u00b7alloc::string::String;\u00b7use\u00b7alloc::vec;\u00b7use\u00b7alloc::vec::Vec;\u00b7use\u00b7esp_alloc::{MemoryCapability,\u00b7HEAP};\u00b7use\u00b7esp_backtrace\u00b7as\u00b7_;\u00b7use\u00b7esp_hal::clock::CpuClock;\u00b7use\u00b7esp_hal::delay::Delay;\u00b7use\u00b7esp_hal::gpio::{self,\u00b7AnyPin,\u00b7InputConfig,\u00b7Pin};\u00b7use\u00b7esp_hal::i2c::master::{Config\u00b7as\u00b7I2cConfig,\u00b7Error,\u00b7I2c};\u00b7use\u00b7esp_hal::main;\u00b7use\u00b7esp_hal::rtc_cntl::wakeup_cause;\u00b7use\u00b7esp_hal::time::{Duration,\u00b7Instant,\u00b7Rate};\u00b7use\u00b7esp_hal::Blocking;\u00b7use\u00b7inkreader_core::fonts::Fonts;\u00b7use\u00b7inkreader_core::render::{Canvas,\u00b7Renderer};\u00b7use\u00b7inkreader_core::settings::Settings;\u00b7use\u00b7inkreader_core::ui::{App,\u00b7SleepScreen,\u00b7Storage,\u00b7HEIGHT,\u00b7WIDTH};\u00b7use\u00b7log::{info,\u00b7warn};\u00b7use\u00b7battery::Battery;\u00b7use\u00b7buttons::Buttons;\u00b7use\u00b7expander::{pin,\u00b7Expander,\u00b7EXP1,\u00b7EXP2};\u00b7use\u00b7panel::{pack_portrait,\u00b7Bus,\u00b7Panel,\u00b7Refresh,\u00b7FB_SIZE};\u00b7use\u00b7sd::Sd;\u00b7use\u00b7storage::CardStorage;\u00b7esp_bootloader_esp_idf::esp_app_desc!();\u00b7///\u00b7What\u00b7the\u00b7panel\u00b7showed\u00b7when\u00b7the\u00b7board\u00b7went\u00b7into\u00b7deep\u00b7sleep,\u00b7kept\u00b7in\u00b7RTC\u00b7///\u00b7memory:\u00b7`SHOWS_PAGE`,\u00b7`SHOWS_EMPTY`,\u00b7or\u00b7anything\u00b7else\u00b7for\u00b7something\u00b7else\u00b7///\u00b7or\u00b7unknown\u00b7(memory\u00b7that\u00b7is\u00b7not\u00b7kept\u00b7starts\u00b7with\u00b7random\u00b7bytes).\u00b7#[esp_hal::ram(unstable(rtc_fast,\u00b7persistent))]\u00b7static\u00b7mut\u00b7PANEL_AT_SLEEP:\u00b7u8\u00b7=\u00b70;\u00b7///\u00b7The\u00b7settled\u00b7page,\u00b7as\u00b7`App::draw`\u00b7draws\u00b7it\u00b7after\u00b7`start`.\u00b7const\u00b7SHOWS_PAGE:\u00b7u8\u00b7=\u00b70xa5;\u00b7///\u00b7The\u00b7\"Battery\u00b7empty\"\u00b7screen.\u00b7const\u00b7SHOWS_EMPTY:\u00b7u8\u00b7=\u00b70x5a;\u00b7///\u00b7With\u00b7`SHOWS_PAGE`:\u00b7the\u00b7charge\u00b7the\u00b7page's\u00b7status\u00b7line\u00b7showed,\u00b7or\u00b70xff\u00b7for\u00b7///\u00b7none.\u00b7The\u00b7page\u00b7drawn\u00b7after\u00b7the\u00b7wake\u00b7must\u00b7match\u00b7the\u00b7panel.\u00b7#[esp_hal::ram(unstable(rtc_fast,\u00b7persistent))]\u00b7static\u00b7mut\u00b7STATUS_BATTERY_AT_SLEEP:\u00b7u8\u00b7=\u00b70xff;\u00b7///\u00b7Runs\u00b7from\u00b7the\u00b7panic\u00b7handler\u00b7before\u00b7the\u00b7backtrace\u00b7is\u00b7printed.\u00b7#[no_mangle]\u00b7fn\u00b7custom_pre_backtrace()\u00b7{\u00b7panel::emergency_off();\u00b7}\u00b7///\u00b7The\u00b7panel\u00b7with\u00b7the\u00b7buffers\u00b7that\u00b7feed\u00b7it.\u00b7struct\u00b7Screen\u00b7{\u00b7panel:\u00b7Panel,\u00b7canvas:\u00b7Canvas,\u00b7fb:\u00b7Vec<u8>,\u00b7///\u00b7The\u00b7framebuffer\u00b7the\u00b7panel\u00b7shows,\u00b7if\u00b7known,\u00b7for\u00b7partial\u00b7refreshes.\u00b7///\u00b7`diff`\u00b7overwrites\u00b7it\u00b7in\u00b7place,\u00b7and\u00b7a\u00b7successful\u00b7refresh\u00b7restores\u00b7it.\u00b7shown:\u00b7Vec<u8>,\u00b7shown_known:\u00b7bool,\u00b7///\u00b7Partial\u00b7refreshes\u00b7since\u00b7the\u00b7last\u00b7full\u00b7one.\u00b7partials:\u00b7u32,\u00b7}\u00b7impl\u00b7Screen\u00b7{\u00b7fn\u00b7new(pins:\u00b7[AnyPin<'static>;\u00b712])\u00b7->\u00b7Self\u00b7{\u00b7Screen\u00b7{\u00b7panel:\u00b7Panel::new(pins),\u00b7canvas:\u00b7Canvas::new(WIDTH,\u00b7HEIGHT),\u00b7fb:\u00b7vec![0u8;\u00b7FB_SIZE],\u00b7shown:\u00b7vec![0u8;\u00b7FB_SIZE],\u00b7shown_known:\u00b7false,\u00b7partials:\u00b70,\u00b7}\u00b7}\u00b7///\u00b7Shows\u00b7the\u00b7canvas.\u00b7One\u00b7refresh\u00b7in\u00b7`full_every`\u00b7is\u00b7a\u00b7full\u00b7one;\u00b7the\u00b7///\u00b7others\u00b7change\u00b7only\u00b7the\u00b7pixels\u00b7that\u00b7differ\u00b7from\u00b7what\u00b7the\u00b7panel\u00b7shows.\u00b7fn\u00b7refresh(&mut\u00b7self,\u00b7bus:\u00b7&mut\u00b7Bus,\u00b7full_every:\u00b7u32)\u00b7{\u00b7pack_portrait(&self.canvas,\u00b7&mut\u00b7self.fb);\u00b7let\u00b7mut\u00b7refresh\u00b7=\u00b7Refresh::Full;\u00b7let\u00b7mut\u0